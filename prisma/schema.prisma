generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  guests          Int
  tripId          String
  tripName        String
  departureId     String?
  departureDate   String?
  totalAmount     Float
  specialRequests String?
  createdAt       DateTime @default(now())
}

model Enquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  journey     String?
  travelDate  String?
  groupSize   String?
  message     String
  hearAboutUs String?
  createdAt   DateTime @default(now())
}
